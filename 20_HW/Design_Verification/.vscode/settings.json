{
  "files.associations": {
    "*.sv": "systemverilog",
    "*.svh": "systemverilog"
  },
  "terminal.integrated.cwd": "${workspaceFolder}",
  "code-runner.runInTerminal": false,
  "code-runner.preserveFocus": false,
  "code-runner.executorMapByFileExtension": {
    ".sv": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$workspaceRoot\\scripts\\run_sv.ps1\" $fullFileName",
    ".svh": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$workspaceRoot\\scripts\\run_sv.ps1\" $fullFileName"
  },
  "search.exclude": {
    "**/build": true
  }
}
